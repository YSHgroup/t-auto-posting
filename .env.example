# Database
DATABASE_URL=postgresql://telegram_user:telegram_password@localhost:5432/telegram_bot

# Redis
REDIS_URL=redis://localhost:6379

# Backend
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
SECRET_KEY=your-secret-key-change-in-production-min-32-chars

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# Telegram
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE_NUMBER=+1234567890

# AI Providers (optional - can be configured per user)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Chrome Extension
EXTENSION_ID=your-extension-id
EXTENSION_URL=chrome-extension://your-extension-id

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS
CORS_ORIGINS=["http://localhost:3000","chrome-extension://your-extension-id"]

# Logging
LOG_LEVEL=INFO
